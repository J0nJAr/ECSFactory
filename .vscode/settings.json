{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.defaultConfigurePreset": "x64-debug",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/out/build/x64-debug/compile_commands.json",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/out/build/x64-debug"
  ]
}
