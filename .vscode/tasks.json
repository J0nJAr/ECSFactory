{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Create C++ Artifact",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/Create-CppArtifact.ps1",
        "-Target",
        "${input:cppTarget}",
        "-Kind",
        "${input:cppArtifactKind}",
        "-RelativePath",
        "${input:cppRelativePath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure x64-debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "x64-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: Create C++ Artifact And Configure",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: Create C++ Artifact",
        "CMake: Configure x64-debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "ECSFactory: Build default",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/Invoke-Dev.ps1",
        "-Action",
        "Build",
        "-Preset",
        "default"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "ECSFactory: Test default",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/Invoke-Dev.ps1",
        "-Action",
        "Test",
        "-Preset",
        "default"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "ECSFactory: Build msvc-debug",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/Invoke-Dev.ps1",
        "-Action",
        "Build",
        "-Preset",
        "msvc-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ECSFactory: Test msvc-debug",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/Invoke-Dev.ps1",
        "-Action",
        "Test",
        "-Preset",
        "msvc-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ECSFactory: Launcher",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-STA",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/Start-DevLauncher.ps1"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "cppTarget",
      "type": "pickString",
      "description": "Choose the CMake target folder to update",
      "options": [
        "EngineCore",
        "EngineRender",
        "GameClient",
        "GameServer",
        "tests"
      ],
      "default": "EngineCore"
    },
    {
      "id": "cppArtifactKind",
      "type": "pickString",
      "description": "Choose what to create",
      "options": [
        "pair",
        "source",
        "header"
      ],
      "default": "pair"
    },
    {
      "id": "cppRelativePath",
      "type": "promptString",
      "description": "Enter a path without extension, for example ECS/SystemRegistry or Feature/NewScene",
      "default": "Feature/NewArtifact"
    }
  ]
}
