{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "default: Single",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/default/bin/GameClient.exe",
      "args": [
        "--single"
      ],
      "cwd": "${workspaceFolder}/out/build/default/bin",
      "preLaunchTask": "ECSFactory: Build default",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "environment": [
        {
          "name": "PATH",
          "value": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      ],
      "externalConsole": false
    },
    {
      "name": "default: Join",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/default/bin/GameClient.exe",
      "args": [
        "--join",
        "127.0.0.1"
      ],
      "cwd": "${workspaceFolder}/out/build/default/bin",
      "preLaunchTask": "ECSFactory: Build default",
